{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting": "Information",
      "Microsoft.AspNetCore.Routing": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "JsonWriterOptions": { "Indented": false }
      }
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Mode": "TokenBucket",
    "Anonymous": { "Capacity": 100, "RefillPerMinute": 100 },
    "Authenticated": { "Capacity": 200, "RefillPerMinute": 300 },
    "SessionLookups": { "Capacity": 30, "RefillPerMinute": 30 },
    "Login": {
      "FailedPerIp": { "Capacity": 10, "RefillPerMinute": 10 },
      "RequestsPerIp": { "Capacity": 60, "RefillPerMinute": 60 },
      "AccountIpThreshold": 5,
      "AccountThreshold": 20,
      "BaseLockSeconds": 30,
      "MaxLockSeconds": 900,
      "FailureWindowSeconds": 900,
      "KnownGoodHours": 24
    },
    "SessionValidation": {
      "BaseUrl": "http://pharmago-users-service:80",
      "TimeoutMs": 1500,
      "PositiveCacheSeconds": 300,
      "NegativeCacheSeconds": 30
    },
    "TrustedProxyHosts": [],
    "TrustedProxyRefreshSeconds": 5,
    "TrustedProxyNetworks": [],
    "MaxTrackedKeys": 100000
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "IpWhitelist": [],
    "EndpointWhitelist": [
      "get:/health",
      "get:/metrics",
      "options:*"
    ],
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/login",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 1000
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "login-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/login"
        }
      },
      "roles-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "invitations-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/invitations/{**catch-all}"
        }
      },
      "pharmacy-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/pharmacy/{**catch-all}"
        }
      },
      "drug-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/drug/{**catch-all}"
        }
      },
      "purchase-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/purchases/{**catch-all}"
        }
      },
      "stock-request-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/stockrequest/{**catch-all}"
        }
      },
      "unit-measure-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/unitmeasures/{**catch-all}"
        }
      },
      "presentation-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/presentations/{**catch-all}"
        }
      },
      "export-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/export/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://pharmago-users-service:80"
          }
        }
      },
      "pharmacy-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://pharmago-pharmacy-service:80"
          }
        }
      }
    }
  }
}
